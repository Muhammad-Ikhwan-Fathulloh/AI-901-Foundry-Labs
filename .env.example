# ==============================================================================
# KONFIGURASI ENVIRONMENT AZURE AI (AI-901)
# Salin file ini menjadi .env lalu sesuaikan dengan resource Azure Anda:
#   Windows : copy .env.example .env
#   Linux/Mac: cp .env.example .env
# PENTING: Jangan pernah melakukan commit file .env ke version control (Git).
# ==============================================================================

# --- 1. Azure AI Foundry & Model Deployments ---
AZURE_AI_PROJECT_ENDPOINT=https://<nama-resource>.services.ai.azure.com/api/projects/<nama-project>
AZURE_AI_CHAT_DEPLOYMENT=<nama-deployment-model-chat>
AZURE_AI_VISION_DEPLOYMENT=<nama-deployment-model-multimodal>
AZURE_AI_IMAGE_DEPLOYMENT=<nama-deployment-model-image-generation>
AZURE_AI_AGENT_NAME=<nama-agen-dari-portal>

# --- 2. Azure AI Speech Service ---
AZURE_SPEECH_KEY=<key-speech-resource>
AZURE_SPEECH_REGION=southeastasia

# --- 3. Azure AI Content Understanding ---
CU_ENDPOINT=https://<nama-resource>.cognitiveservices.azure.com
CU_KEY=<key-content-understanding>
