# Salin file ini menjadi .env lalu isi nilainya. Jangan commit file .env.
AZURE_AI_PROJECT_ENDPOINT=https://<resource-name>.services.ai.azure.com/api/projects/<project-name>
AZURE_AI_CHAT_DEPLOYMENT=<nama-deployment-model-chat>
AZURE_AI_VISION_DEPLOYMENT=<nama-deployment-model-multimodal>
AZURE_AI_IMAGE_DEPLOYMENT=<nama-deployment-model-image-generation>
AZURE_AI_AGENT_NAME=<nama-agen-dari-portal>

AZURE_SPEECH_KEY=<key-speech-resource>
AZURE_SPEECH_REGION=<region-speech, misalnya southeastasia>

CU_ENDPOINT=https://<resource-name>.cognitiveservices.azure.com
CU_KEY=<key-content-understanding>
