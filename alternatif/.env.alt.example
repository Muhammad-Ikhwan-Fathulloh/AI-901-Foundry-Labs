# ==============================================================================
# KONFIGURASI ALTERNATIF AI MODEL (OLLAMA / OPENAI / GEMINI)
# ==============================================================================

# Pilih provider yang ingin digunakan: "ollama" | "openai" | "gemini"
AI_PROVIDER=ollama

# --- 1. OLLAMA (Lokal & 100% Gratis - Tanpa API Key) ---
# Install dari: https://ollama.com
# Jalankan perintah: ollama run llama3.2  (atau: ollama run llava untuk multimodal)
OLLAMA_BASE_URL=http://localhost:11434/v1
OLLAMA_CHAT_MODEL=llama3.2
OLLAMA_VISION_MODEL=llava

# --- 2. OPENAI (Cloud - Butuh OpenAI API Key) ---
OPENAI_API_KEY=sk-...
OPENAI_CHAT_MODEL=gpt-4o-mini
OPENAI_VISION_MODEL=gpt-4o-mini

# --- 3. GOOGLE GEMINI (Cloud - Gratis di Google AI Studio) ---
# Dapatkan key di: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=AIzaSy...
GEMINI_CHAT_MODEL=gemini-1.5-flash
GEMINI_VISION_MODEL=gemini-1.5-flash
